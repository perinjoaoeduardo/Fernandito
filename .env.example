# Número comercial do WhatsApp usado pelo botão de CTA ("Fale no WhatsApp").
# Formato: código do país + DDD + número, só dígitos (sem espaços, +, -, ().
# Exemplo: 5551999999999 (Brasil, DDD 51)
#
# Enquanto essa variável estiver vazia/ausente, o botão fica visualmente
# igual mas desabilitado (não navega pra lugar nenhum).
NEXT_PUBLIC_WHATSAPP_NUMBER=
