# Número comercial do WhatsApp usado pelo botão de CTA ("Fale no WhatsApp").
# Formato: código do país + DDD + número, só dígitos (sem espaços, +, -, ().
# Exemplo: 5551999999999 (Brasil, DDD 51)
#
# Opcional: vazia, o botão usa o número de src/content/site.ts
# (LINKS.whatsappNumber). Preenchida, tem prioridade sobre ele.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Código de verificação do Google Search Console (só o valor do content da
# meta tag). Vazia = a meta tag não é emitida.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Loja: pagamento Pix (Mercado Pago) — SÓ SERVIDOR, nunca NEXT_PUBLIC ──
# Credencial da aplicação no Mercado Pago (Suas integrações → Credenciais).
# Teste: a de teste (TEST-...). Produção: a de produção (APP_USR-...).
# Vazia fora de produção = Pix SIMULADO (só pra ver as telas).
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" do webhook (Suas integrações → Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=

# ── Loja: banco de pedidos (Upstash Redis) ──
# Criados sozinhos ao conectar "Upstash for Redis" ao projeto na Vercel
# (Storage). Também aceita UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# Vazios fora de produção = pedidos só em memória (somem ao reiniciar).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Loja: Bling (pedido de venda quando o Pix é pago) — SÓ SERVIDOR ──
# App criado no Bling (Central de Extensões → Área do integrador). Link de
# redirecionamento do app: https://fernandito.com.br/api/bling/callback
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Senha longa (16+ caracteres) pra abrir /api/bling/connect?key=... (conectar 1x).
BLING_ADMIN_KEY=
# Opcionais: id da forma de pagamento Pix e da loja/canal no Bling (vazio =
# procura a forma Pix sozinho; sem loja).
BLING_FORMA_PAGAMENTO_ID=
BLING_LOJA_ID=
# Preview/local só manda pedido pro Bling com 1 (pedido de teste vira pedido real lá!).
BLING_SYNC_PREVIEW=
# Protege o cron diário (/api/cron/bling). A Vercel envia sozinha.
CRON_SECRET=
# Situação do pedido ao entrar no Bling (padrão 15 = "Em andamento"; 6 = "Em aberto").
BLING_SITUACAO_ID=
# Logística dos pedidos de Porto Alegre (procurada pelo nome; ou fixe o código do serviço).
BLING_LOGISTICA_POA_NOME=
BLING_LOGISTICA_POA_SERVICO=
# Campos customizados do contato (procurados pelo nome; ou fixe os ids).
BLING_CAMPO_MARKETING_ID=
BLING_CAMPO_18_ID=

# ── Loja: frete (Melhor Envio) — SÓ SERVIDOR ──
# Token do painel do Melhor Envio (permissão "shipping-calculate").
MELHOR_ENVIO_TOKEN=
# CEP de onde sai o produto.
MELHOR_ENVIO_CEP_ORIGEM=90430131
# 1 = ambiente de testes do Melhor Envio (token do sandbox).
MELHOR_ENVIO_SANDBOX=
# "Nome (e-mail de contato técnico)" — o Melhor Envio pede em toda chamada.
MELHOR_ENVIO_USER_AGENT=
